<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_user_account_list" model="ir.ui.view">
        <field name="name">telegram.user.account.list</field>
        <field name="model">telegram.user.account</field>
        <field name="arch" type="xml">
            <list string="Telegram Accounts">
                <field name="enabled"/>
                <field name="account_ref"/>
                <field name="phone_number"/>
                <field name="auth_state"/>
                <field name="last_chat_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_user_account_form" model="ir.ui.view">
        <field name="name">telegram.user.account.form</field>
        <field name="model">telegram.user.account</field>
        <field name="arch" type="xml">
            <form string="Telegram Account">
                <header>
                    <button name="action_send_code" string="Send Code" type="object" class="btn-primary" invisible="manual_session_only"/>
                    <button name="action_resend_code" string="Resend Code" type="object" invisible="manual_session_only"/>
                    <button name="action_verify_code" string="Verify Code" type="object" invisible="manual_session_only"/>
                    <button name="action_verify_password" string="Verify Password" type="object" invisible="manual_session_only"/>
                    <button name="action_fetch_chats" string="Fetch Chats" type="object" class="btn-primary"/>
                    <field name="auth_state" widget="statusbar" statusbar_visible="draft,code_sent,password_required,authorized,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="enabled"/>
                            <field name="manual_session_only"/>
                            <field name="account_ref"/>
                            <field name="phone_number"/>
                            <field name="api_id"/>
                            <field name="api_hash" password="True"/>
                        </group>
                        <group>
                            <field name="auth_code" placeholder="Enter SMS/Telegram code" invisible="manual_session_only"/>
                            <field name="auth_password" password="True" placeholder="Enter 2FA password if needed" invisible="manual_session_only"/>
                            <field name="phone_code_hash" readonly="1" invisible="manual_session_only"/>
                            <field name="auth_expires_at" readonly="1" invisible="manual_session_only"/>
                            <field name="code_delivery_type" readonly="1" invisible="manual_session_only"/>
                            <field name="code_next_type" readonly="1" invisible="manual_session_only"/>
                            <field name="code_timeout_seconds" readonly="1" invisible="manual_session_only"/>
                        </group>
                    </group>
                    <group>
                        <field name="session_string" widget="text"/>
                        <field name="last_error" readonly="1"/>
                        <field name="last_chat_sync_at" readonly="1"/>
                        <field name="last_chat_sync_error" readonly="1"/>
                    </group>
                    <group>
                        <field name="chat_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="title"/>
                                <field name="chat_id"/>
                                <field name="username"/>
                                <field name="chat_type"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_user_account" model="ir.actions.act_window">
        <field name="name">Telegram Accounts</field>
        <field name="res_model">telegram.user.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_telegram_auto_reply_route_list" model="ir.ui.view">
        <field name="name">telegram.auto.reply.route.list</field>
        <field name="model">telegram.auto.reply.route</field>
        <field name="arch" type="xml">
            <list string="Telegram Auto Reply Routes">
                <field name="enabled"/>
                <field name="account_id"/>
                <field name="account_ref"/>
                <field name="phone_number"/>
                <field name="chat_ref_id"/>
                <field name="chat_id"/>
                <field name="keyword"/>
                <field name="response"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_auto_reply_route_form" model="ir.ui.view">
        <field name="name">telegram.auto.reply.route.form</field>
        <field name="model">telegram.auto.reply.route</field>
        <field name="arch" type="xml">
            <form string="Telegram Auto Reply Route">
                <sheet>
                    <group>
                        <field name="enabled"/>
                        <field name="account_id"/>
                        <field name="account_ref" readonly="1"/>
                        <field name="phone_number" readonly="1"/>
                        <field name="chat_ref_id" domain="[('account_id', '=', account_id)]"/>
                        <field name="chat_id"/>
                        <field name="keyword"/>
                        <field name="response"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_auto_reply_route" model="ir.actions.act_window">
        <field name="name">Telegram Auto Replies</field>
        <field name="res_model">telegram.auto.reply.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_telegram_sync_root" name="Telegram Sync" sequence="90"/>
    <menuitem
        id="menu_telegram_accounts"
        name="Accounts"
        parent="menu_telegram_sync_root"
        action="action_telegram_user_account"
        sequence="5"
    />
    <menuitem
        id="menu_telegram_auto_reply_routes"
        name="Auto Reply Routes"
        parent="menu_telegram_sync_root"
        action="action_telegram_auto_reply_route"
        sequence="10"
    />
</odoo>
